    {
      "binding": "DB",
      "database_name": "private-fund-mcp",
      // Created with `npx wrangler d1 create private-fund-mcp` (prompt 3).
      "database_id": "3000b8b6-a7cf-44e9-950a-b735b1ad502b"
    }
  ]
}
